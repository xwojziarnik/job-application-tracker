# Copy to .env and adjust. Values here are local development defaults.
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker
DATABASE_ECHO=false

# Host interface and ports used by docker compose (change the ports if 8000/5432 are taken).
# 127.0.0.1 keeps the API and database reachable from this machine only.
BIND_HOST=127.0.0.1
API_PORT=8000
DB_PORT=5432
